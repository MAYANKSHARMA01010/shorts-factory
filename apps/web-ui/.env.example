# ═══════════════════════════════════════════════════════════════════════════
#  Shorts Factory — Next.js Web UI Environment Example (.env.example)
#  Copy this file to .env and adjust variables if needed.
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=3000

# ── API Backend Connection ─────────────────────────────────────────────────
# URL of the Flask API backend server (default: port 5001)
NEXT_PUBLIC_API_URL=http://127.0.0.1:5001
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:5001
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
