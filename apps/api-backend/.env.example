# ═══════════════════════════════════════════════════════════════════════════
#  Shorts Factory — API Backend Environment Example (.env.example)
#  Copy this file to .env and fill in your actual credentials.
# ═══════════════════════════════════════════════════════════════════════════

# ── Server Configuration ──────────────────────────────────────────────────
SERVER_PORT=5001
NODE_ENV=development

FRONTEND_LOCAL_URL=http://localhost:3000
BACKEND_LOCAL_URL=http://localhost:5001

# ── Gemini AI Models ──────────────────────────────────────────────────────
# Preferred 100% free Gemini models on Google AI Studio
GEMINI_PRIMARY_MODEL=gemini-2.0-flash
GEMINI_CANDIDATE_MODEL=gemini-2.0-flash-lite

# ── Gemini & Third-Party API Keys ─────────────────────────────────────────
# Get free Gemini key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Get free Pexels key at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# ── YouTube OAuth Credentials ─────────────────────────────────────────────
# Get via Google Cloud Console -> APIs & Services -> Credentials
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here
GCP_PROJECT_NUMBER=your_gcp_project_number_here
