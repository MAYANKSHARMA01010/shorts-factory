# =============================================================================
# SHORTS-FACTORY .gitignore
# Prevents secrets, dependencies, build outputs, media, logs, & cache from Git
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SECRETS & CREDENTIALS (NEVER COMMIT)
# -----------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
*.key
*.pem
*.pfx
*.p12
*.crt
*.csr
email.json
*secret*
*token*
!*_token*.md          # Allow documentation mentioning the word "token"
client_secret*.json
credentials*.json
service-account*.json
MYVAR
**/.config/**

# -----------------------------------------------------------------------------
# 2. PYTHON & VIRTUAL ENVIRONMENTS
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
env/
ENV/
*-env/
chatterbox-env/
imggen-env/

# -----------------------------------------------------------------------------
# 3. NODE / FRONTEND / REMOTION BUILD ARTIFACTS
# -----------------------------------------------------------------------------
node_modules/
.next/
out/
.turbo/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# -----------------------------------------------------------------------------
# 4. DATABASES & STATE / RUNTIME LOGS
# -----------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
clippilot.db
runtime/logs/*.log
*.log
runtime/state/.video_progress.json
runtime/state/reimagined_progress.json
runtime/state/digest_last.html
runtime/state/*.txt

# -----------------------------------------------------------------------------
# 5. MEDIA, AUDIO, VIDEO & MODEL WEIGHTS (REGENERATE, DO NOT TRACK)
# -----------------------------------------------------------------------------
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.wav
*.mp3
*.flac
*.aac
*.m4a
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.ico
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.onnx

# Specific generation/render output directories
models/
downloads/
hd_sources/
output/
FINAL_SHORTS/
qa_frames/
transcripts/
skill_backups/
**/data/media/
packages/ClipPilot/data/explainer_*/
**/_work_*/
**/_projects/

# -----------------------------------------------------------------------------
# 6. IDE / OS / SYSTEM CLUTTER
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.tmp
*.temp
